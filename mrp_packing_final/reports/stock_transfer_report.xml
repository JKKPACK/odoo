<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="report_picking_jkk" inherit_id="stock.report_picking" priority="99">
    <xpath expr="//div[hasclass('page')]" position="replace">
      <div class="page" style="font-family:Arial,sans-serif;color:#222;">
        <table style="width:100%;border-collapse:collapse;margin-bottom:10px;">
          <tr>
            <td style="width:70%;vertical-align:middle;">
              <div style="font-size:13px;font-weight:800;text-transform:uppercase;">PROCESO: <span t-esc="o.jkk_process or '-'"/></div>
              <div style="font-size:11px;color:#666;text-transform:uppercase;margin-top:2px;">Manufactura / Manufacturing</div>
              <div style="font-size:24px;font-weight:800;">SOLICITUD DE TRASLADO / SOLICITUD DE MATERIALES</div>
              <div style="font-size:17px;font-weight:800;margin-top:3px;"><span t-field="o.name"/></div>
            </td>
            <td style="width:30%;text-align:right;vertical-align:middle;">
              <span t-field="o.name" t-options="{'widget':'barcode','width':600,'height':100,'img_style':'width:280px;height:48px'}"/>
            </td>
          </tr>
        </table>
        <div style="border-top:3px solid #333;margin-bottom:12px;"></div>
        <table style="width:100%;border-collapse:collapse;table-layout:fixed;margin-bottom:14px;font-size:10px;">
          <tr>
            <td style="width:50%;padding:6px;border:1px solid #ddd;"><b>Proceso:</b> <span t-esc="o.jkk_process or '-'"/></td>
            <td style="width:50%;padding:6px;border:1px solid #ddd;"><b>Fecha creación:</b> <span t-field="o.create_date"/></td>
          </tr>
          <tr>
            <td style="padding:6px;border:1px solid #ddd;"><b>Orden de Fabricación:</b> <span t-esc="o.jkk_production_id.name if o.jkk_production_id else '-'"/></td>
            <td style="padding:6px;border:1px solid #ddd;"><b>Orden de Venta:</b> <span t-esc="o.jkk_sale_order_id.name if o.jkk_sale_order_id else '-'"/></td>
          </tr>
          <tr>
            <td colspan="2" style="padding:6px;border:1px solid #ddd;"><b>Almacén / Origen:</b> <span t-field="o.location_id.display_name"/></td>
          </tr>
        </table>
        <div style="font-size:14px;font-weight:800;margin:10px 0 6px;border-bottom:2px solid #333;padding-bottom:4px;">Materiales solicitados</div>
        <table style="width:100%;border-collapse:collapse;table-layout:fixed;font-size:9px;">
          <thead><tr style="background:#333;color:#fff;">
            <th style="width:18%;padding:7px;text-align:left;">Artículo</th>
            <th style="width:42%;padding:7px;text-align:left;">Descripción</th>
            <th style="width:15%;padding:7px;text-align:right;">Cantidad necesaria</th>
            <th style="width:10%;padding:7px;text-align:center;">UdM</th>
            <th style="width:15%;padding:7px;text-align:left;">Estado</th>
          </tr></thead>
          <tbody>
            <t t-foreach="o.move_ids" t-as="move">
              <tr style="border-bottom:1px solid #ddd;page-break-inside:avoid;">
                <td style="padding:6px;font-weight:700;"><span t-esc="move.product_id.default_code or ''"/></td>
                <td style="padding:6px;"><span t-field="move.product_id.display_name"/></td>
                <td style="padding:6px;text-align:right;font-weight:700;"><span t-field="move.product_uom_qty"/></td>
                <td style="padding:6px;text-align:center;"><span t-field="move.product_uom"/></td>
                <td style="padding:6px;"><span t-field="move.state"/></td>
              </tr>
            </t>
          </tbody>
        </table>
        <div style="margin-top:18px;border:1px solid #bbb;min-height:70px;padding:8px;">
          <div style="font-size:10px;font-weight:800;margin-bottom:5px;">Comentarios</div>
          <span t-field="o.note"/>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
