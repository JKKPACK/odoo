<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pallet_zpl">
        <t t-foreach="docs" t-as="doc"><t t-raw="doc.generate_pallet_zpl()"/></t>
    </template>

    <template id="report_packing_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 9pt; color:#111; margin:0; padding:0;">
                        <t t-set="company" t-value="o.production_id.company_id if o.production_id else res_company"/>

                        <!-- Encabezado propio: evita la superposición de web.external_layout -->
                        <table style="width:100%; border-collapse:collapse; margin:0 0 5mm 0; table-layout:fixed;">
                            <tr>
                                <td style="width:18%; vertical-align:top; padding:0 5mm 0 0;">
                                    <img t-if="company.logo"
                                         t-att-src="image_data_uri(company.logo)"
                                         style="max-width:42mm; max-height:18mm; object-fit:contain;"/>
                                </td>
                                <td style="width:47%; vertical-align:top; padding:0 3mm; line-height:1.35;">
                                    <div style="font-size:12pt; font-weight:700; margin-bottom:1mm;">
                                        <span t-field="company.name"/>
                                    </div>
                                    <div style="font-size:7.5pt; color:#555;">
                                        <t t-if="company.street"><span t-field="company.street"/></t>
                                        <t t-if="company.street2">, <span t-field="company.street2"/></t>
                                    </div>
                                    <div style="font-size:7.5pt; color:#555;">
                                        <t t-if="company.city"><span t-field="company.city"/></t>
                                        <t t-if="company.state_id">, <span t-field="company.state_id.name"/></t>
                                        <t t-if="company.zip"> <span t-field="company.zip"/></t>
                                        <t t-if="company.country_id">, <span t-field="company.country_id.name"/></t>
                                    </div>
                                    <div t-if="company.phone" style="font-size:7.5pt; color:#555;">
                                        Tel: <span t-field="company.phone"/>
                                    </div>
                                </td>
                                <td style="width:35%; vertical-align:top; text-align:right; padding:0;">
                                    <div style="font-size:7.5pt; color:#666; text-transform:uppercase;">Tarima / Pallet</div>
                                    <div style="font-size:18pt; font-weight:700; line-height:1.1;"><span t-field="o.name"/></div>
                                    <div style="font-size:7.5pt; color:#666; margin-top:2mm;">Fecha / Date</div>
                                    <div style="font-size:9pt; font-weight:700;">
                                        <span t-field="o.date_packing" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Título separado del encabezado de compañía -->
                        <div style="border-top:2px solid #222; border-bottom:2px solid #222; padding:3mm 0; margin-bottom:4mm; text-align:center;">
                            <div style="font-size:18pt; font-weight:700; line-height:1.05;">LISTA DE EMPAQUE</div>
                            <div style="font-size:9pt; letter-spacing:1.2px; margin-top:1mm;">PACKING LIST</div>
                        </div>

                        <!-- Información general -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:4mm; table-layout:fixed;">
                            <tbody>
                                <tr>
                                    <td style="width:50%; border:1px solid #aaa; padding:2.5mm; vertical-align:top;">
                                        <div style="font-size:7pt; color:#666; text-transform:uppercase;">Cliente / Customer</div>
                                        <div style="font-size:10pt; font-weight:700; margin-top:1mm; overflow-wrap:anywhere;">
                                            <t t-if="o.customer_code"><span t-field="o.customer_code"/> — </t>
                                            <span t-field="o.customer_name"/>
                                        </div>
                                    </td>
                                    <td style="width:25%; border:1px solid #aaa; padding:2.5mm; vertical-align:top;">
                                        <div style="font-size:7pt; color:#666; text-transform:uppercase;">Orden de Venta / Sales Order</div>
                                        <div style="font-size:10pt; font-weight:700; margin-top:1mm;"><span t-field="o.sale_order_id.name"/></div>
                                    </td>
                                    <td style="width:25%; border:1px solid #aaa; padding:2.5mm; vertical-align:top;">
                                        <div style="font-size:7pt; color:#666; text-transform:uppercase;">Pedido Cliente / Customer Order</div>
                                        <div style="font-size:10pt; font-weight:700; margin-top:1mm; overflow-wrap:anywhere;"><span t-field="o.customer_order_ref"/></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #aaa; padding:2.5mm; vertical-align:top;">
                                        <div style="font-size:7pt; color:#666; text-transform:uppercase;">Producto / Product</div>
                                        <div style="font-size:9pt; font-weight:700; margin-top:1mm; line-height:1.25; overflow-wrap:anywhere;">
                                            <t t-if="o.product_id.default_code">[<span t-field="o.product_id.default_code"/>] </t>
                                            <span t-field="o.product_id.name"/>
                                        </div>
                                        <t t-if="o.customer_label_text">
                                            <div style="font-size:7.5pt; margin-top:1mm; line-height:1.25; overflow-wrap:anywhere;"><span t-field="o.customer_label_text"/></div>
                                        </t>
                                    </td>
                                    <td style="border:1px solid #aaa; padding:2.5mm; vertical-align:top;">
                                        <div style="font-size:7pt; color:#666; text-transform:uppercase;">Orden de Fabricación / MO</div>
                                        <div style="font-size:9.5pt; font-weight:700; margin-top:1mm;">
                                            <t t-if="o.production_id"><span t-field="o.production_id.name"/></t>
                                            <t t-else="">MANUAL</t>
                                        </div>
                                    </td>
                                    <td style="border:1px solid #aaa; padding:2.5mm; vertical-align:top;">
                                        <div style="font-size:7pt; color:#666; text-transform:uppercase;">Centro / Work Center</div>
                                        <div style="font-size:9pt; font-weight:700; margin-top:1mm; overflow-wrap:anywhere;"><span t-field="o.workcenter_id.name"/></div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Resumen -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:4mm; table-layout:fixed;">
                            <tr>
                                <td style="width:25%; border:1px solid #999; padding:2.5mm; text-align:center;">
                                    <div style="font-size:7pt; color:#666;">CAJAS / ROLLOS</div>
                                    <div style="font-size:14pt; font-weight:700; margin-top:1mm;"><span t-field="o.box_count"/></div>
                                </td>
                                <td style="width:25%; border:1px solid #999; padding:2.5mm; text-align:center;">
                                    <div style="font-size:7pt; color:#666;">CANTIDAD TOTAL</div>
                                    <div style="font-size:14pt; font-weight:700; margin-top:1mm;"><span t-field="o.total_qty" t-options='{"widget":"float","precision":2}'/></div>
                                </td>
                                <td style="width:25%; border:1px solid #999; padding:2.5mm; text-align:center;">
                                    <div style="font-size:7pt; color:#666;">PESO BRUTO / GROSS</div>
                                    <div style="font-size:14pt; font-weight:700; margin-top:1mm;"><span t-field="o.total_gross_weight" t-options='{"widget":"float","precision":2}'/> kg</div>
                                </td>
                                <td style="width:25%; border:1px solid #999; padding:2.5mm; text-align:center;">
                                    <div style="font-size:7pt; color:#666;">PESO NETO / NET</div>
                                    <div style="font-size:14pt; font-weight:700; margin-top:1mm;"><span t-field="o.total_net_weight" t-options='{"widget":"float","precision":2}'/> kg</div>
                                </td>
                            </tr>
                        </table>

                        <!-- Detalle -->
                        <table style="width:100%; border-collapse:collapse; font-size:8pt; margin:0; table-layout:fixed;">
                            <thead style="display:table-header-group;">
                                <tr style="background:#ededed; border-top:2px solid #222; border-bottom:2px solid #222;">
                                    <th style="width:9%; padding:2mm 1.5mm; text-align:center;">#<br/>Caja/Rollo</th>
                                    <th style="width:31%; padding:2mm; text-align:left;">Lote Maestro<br/><span style="font-weight:400;">Master Lot</span></th>
                                    <th style="width:20%; padding:2mm; text-align:right;">Peso Bruto<br/><span style="font-weight:400;">Gross Weight</span></th>
                                    <th style="width:20%; padding:2mm; text-align:right;">Peso Neto<br/><span style="font-weight:400;">Net Weight</span></th>
                                    <th style="width:20%; padding:2mm; text-align:right;">Cantidad<br/><span style="font-weight:400;">Qty / Box</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.box_ids.sorted('sequence')" t-as="b" style="border-bottom:1px solid #ccc; page-break-inside:avoid;">
                                    <td style="padding:1.8mm 1.5mm; text-align:center; font-weight:700;"><span t-field="b.sequence"/></td>
                                    <td style="padding:1.8mm 2mm; overflow-wrap:anywhere;"><span t-field="b.lot_code"/></td>
                                    <td style="padding:1.8mm 2mm; text-align:right;"><span t-field="b.peso_bruto" t-options='{"widget":"float","precision":2}'/> kg</td>
                                    <td style="padding:1.8mm 2mm; text-align:right;"><span t-field="b.peso_neto" t-options='{"widget":"float","precision":2}'/> kg</td>
                                    <td style="padding:1.8mm 2mm; text-align:right;"><span t-field="b.qty_per_box" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                                <tr style="font-weight:700; border-top:2px solid #222; border-bottom:2px solid #222; background:#f6f6f6; page-break-inside:avoid;">
                                    <td style="padding:2mm 1.5mm;"></td>
                                    <td style="padding:2mm;">TOTAL</td>
                                    <td style="padding:2mm; text-align:right;"><span t-field="o.total_gross_weight" t-options='{"widget":"float","precision":2}'/> kg</td>
                                    <td style="padding:2mm; text-align:right;"><span t-field="o.total_net_weight" t-options='{"widget":"float","precision":2}'/> kg</td>
                                    <td style="padding:2mm; text-align:right;"><span t-field="o.total_qty" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Operación -->
                        <table style="width:100%; border-collapse:collapse; margin-top:4mm; font-size:7.5pt; table-layout:fixed; page-break-inside:avoid;">
                            <tr>
                                <td style="width:34%; border:1px solid #bbb; padding:2.5mm; vertical-align:top;">
                                    <strong>Centro de Trabajo / Work Center</strong><br/><span t-field="o.workcenter_id.name"/>
                                </td>
                                <td style="width:33%; border:1px solid #bbb; padding:2.5mm; vertical-align:top;">
                                    <strong>Máquina / Machine</strong><br/><span t-field="o.machine"/>
                                </td>
                                <td style="width:33%; border:1px solid #bbb; padding:2.5mm; vertical-align:top;">
                                    <strong>Operador / Operator</strong><br/><span t-field="o.operator_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Firmas -->
                        <table style="width:100%; border-collapse:collapse; margin-top:14mm; page-break-inside:avoid; table-layout:fixed;">
                            <tr>
                                <td style="width:42%; text-align:center; vertical-align:top;">
                                    <div style="border-top:1px solid #222; padding-top:2mm;">Producción / Production</div>
                                </td>
                                <td style="width:16%;"></td>
                                <td style="width:42%; text-align:center; vertical-align:top;">
                                    <div style="border-top:1px solid #222; padding-top:2mm;">Almacén / Store</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
