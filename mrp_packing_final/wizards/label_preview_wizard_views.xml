<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pallet_label_preview_wizard" model="ir.ui.view">
        <field name="name">pallet.label.preview.wizard.form</field>
        <field name="model">pallet.label.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Etiquetas ZPL" create="0" edit="0" class="o_mrp_zpl_preview_form">
                <sheet>
                    <!-- Metadatos técnicos disponibles para la acción, pero ocultos al operador. -->
                    <field name="label_type" invisible="1"/>
                    <field name="pallet_id" invisible="1"/>
                    <field name="box_ids" invisible="1"/>
                    <field name="zpl_code" invisible="1"/>

                    <div class="text-muted mb-2" invisible="label_count &lt;= 1">
                        <span>Etiquetas: </span><field name="label_count" class="d-inline"/>
                    </div>

                    <!-- Caja/Bobina 4x6: una etiqueta por fila, completa y centrada. -->
                    <field name="preview_line_ids" nolabel="1" readonly="1" invisible="label_type != 'box'">
                        <kanban class="o_mrp_zpl_preview_kanban o_mrp_zpl_preview_box" create="0" delete="0">
                            <field name="name"/>
                            <field name="preview_image"/>
                            <templates>
                                <t t-name="card">
                                    <div class="o_mrp_zpl_preview_card p-2 text-center">
                                        <h5 class="mb-2"><field name="name"/></h5>
                                        <field name="preview_image" widget="image" class="img-fluid"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>

                    <!-- Master 6x4: muestra exactamente la orientación física enviada a Zebra. -->
                    <field name="preview_line_ids" nolabel="1" readonly="1" invisible="label_type != 'master'">
                        <kanban class="o_mrp_zpl_preview_kanban o_mrp_zpl_preview_master" create="0" delete="0">
                            <field name="name"/>
                            <field name="preview_image"/>
                            <templates>
                                <t t-name="card">
                                    <div class="o_mrp_zpl_preview_card p-2 text-center">
                                        <h5 class="mb-2"><field name="name"/></h5>
                                        <field name="preview_image" widget="image" class="img-fluid"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
                <footer>
                    <button name="action_print_zpl" string="Zebra ZPL" type="object"
                            class="btn-primary" icon="fa-print" title="Zebra ZPL"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
