<odoo>
    <record id="view_pallet_label_preview_wizard" model="ir.ui.view">
        <field name="name">pallet.label.preview.wizard.form</field>
        <field name="model">pallet.label.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Vista Previa de Etiqueta ZPL">
                <sheet>
                    <div class="row">
                        <div class="col-7 text-center" style="border-right: 1px solid #dee2e6; padding-right: 20px;">
                            <h4 class="mb-3" style="color: #4A5568; font-weight: bold;">
                                Simulación de Impresión (ZT411)
                            </h4>
                            <field name="preview_image" widget="image" nolabel="1" class="img-fluid" options="{'size': [420, 630]}" style="border: 1px solid #dee2e6; padding: 8px; background-color: #ffffff;"/>
                        </div>

                        <div class="col-5" style="padding-left: 20px;">
                            <h4 class="mb-3" style="color: #4A5568; font-weight: bold;">
                                Información del Control
                            </h4>
                            <group>
                                <field name="pallet_id" options="{'no_open': True}"/>
                            </group>
                            <notebook>
                                <page string="Código Fuente ZPL (Nativo)">
                                    <field name="zpl_code" widget="text" nolabel="1" rows="18" style="font-family: 'Courier New', monospace; font-size: 11px; background-color: #f8f9fa;"/>
                                </page>
                            </notebook>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_print_zpl" string="Imprimir en Zebra" type="object" class="btn-primary" icon="fa-print"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
