<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pallet_start_wizard" model="ir.ui.view">
        <field name="name">pallet.start.wizard.form</field>
        <field name="model">pallet.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Iniciar Empaquetado">
                <header>
                    <button name="action_load_partial_productions" type="object"
                            string="Cargar producciones parciales" icon="fa-refresh"
                            class="btn-primary"
                            invisible="is_reprint or not can_pack_partial_productions"/>
                </header>
                <group>
                    <field name="production_id" readonly="1"/>
                    <field name="operator_id"/>
                    <field name="workcenter_id" domain="[('is_finished_product', '=', True)]" invisible="not workcenter_id"/>
                    <field name="machine" readonly="1" invisible="not machine"/>
                    <field name="can_pack_partial_productions" invisible="1"/>
                    <field name="include_partial_productions" invisible="1"/>
                    <field name="partial_production_ids" invisible="1"/>
                    <field name="production_selection_line_ids" nolabel="1"
                           invisible="not production_selection_line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="selected" widget="boolean_toggle" readonly="is_main"/>
                            <field name="production_id"/>
                            <field name="is_main" widget="boolean"/>
                            <field name="qty_producing"/>
                            <field name="available_lot_count"/>
                        </list>
                    </field>
                    <field name="num_boxes" string="¿Cuántas cajas/bobinas tiene la tarima?" invisible="is_reprint"/>
                    <field name="is_reprint" invisible="1"/>
                    <field name="pallet_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_next" string="Siguiente - Capturar lotes y pesos" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_box_entry_wizard" model="ir.ui.view">
        <field name="name">box.entry.wizard.form</field>
        <field name="model">box.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Captura de Cajas/Bobinas">
                <sheet>
                    <h2>Tarima: <field name="pallet_id" readonly="1"/></h2>
                    <group>
                        <group>
                            <field name="total_gross" readonly="1" string="Acumulación pesos brutos"/>
                            <field name="total_net" readonly="1" string="Acumulación pesos netos"/>
                            <field name="total_qty" readonly="1" string="Sumatoria cantidad x caja"/>
                        </group>
                        <group>
                            <field name="tara"/>
                            <field name="lot_ids_empacados" widget="many2many_tags" readonly="1" invisible="not lot_ids_empacados"/>
                        </group>
                    </group>
                    <field name="is_grouped_production_packing" invisible="1"/>
                    <field name="packing_production_ids" invisible="1"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" readonly="1"/>
                            <field name="source_production_id" optional="show" invisible="not parent.is_grouped_production_packing"/>
                            <field name="lot_id" required="1" domain="[('id', 'in', lot_ids_disponibles), ('id', 'not in', lot_ids_usados)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="lot_ids_disponibles" invisible="1"/>
                            <field name="lot_ids_usados" invisible="1"/>
                            <field name="peso_bruto" required="1" placeholder="14.60"/>
                            <field name="peso_neto" readonly="1"/>
                            <field name="tara" required="1"/>
                            <field name="qty_per_box" required="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Cerrar Tarima y Generar Etiquetas" type="object" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
