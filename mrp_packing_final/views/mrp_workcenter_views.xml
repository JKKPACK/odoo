<odoo>
    <record id="view_mrp_workcenter_form_finished" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.finished</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_finished_product" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>