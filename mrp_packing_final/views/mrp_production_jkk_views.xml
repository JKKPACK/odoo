<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_jkk_merged" model="ir.ui.view">
        <field name="name">mrp.production.form.jkk.merged</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Datos de Producción JKK">
                    <group>
                        <field name="design_no" readonly="state != 'draft'"/>
                        <field name="sale_reference" readonly="1"/>
                        <field name="bom_reference" readonly="1"/>
                        <field name="expiration_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="production_type" readonly="state != 'draft'"/>
                        <field name="origin_type" readonly="state != 'draft'"/>
                        <field name="order_type" readonly="state != 'draft'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_form_components_jkk_merged" model="ir.ui.view">
        <field name="name">mrp.production.form.components.jkk.merged</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='components']//field[@name='product_id']" position="before">
                <field name="line_number" string="#" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='product_uom']" position="after">
                <field name="location_internal_id" string="Almacén" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
