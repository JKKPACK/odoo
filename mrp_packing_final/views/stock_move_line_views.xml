<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit.jkkpack</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="x_lote_proveedor" placeholder="Lote Prov." optional="show"/>
                <field name="x_rollo_proveedor" placeholder="Rollo Prov." optional="show"/>
                <field name="x_factura_proveedor" placeholder="Factura Prov." optional="show"/>
                <field name="x_calibre" optional="show"/>
                <field name="x_ancho" optional="show"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_open_label_preview" string="Ver Etiqueta" type="object" icon="fa-search-plus" class="btn-sm btn-link text-info" title="Ver vista previa de la etiqueta Zebra"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.tree.inherit.jkkpack</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="x_lote_proveedor" placeholder="Lote Prov." optional="show"/>
                <field name="x_rollo_proveedor" placeholder="Rollo Prov." optional="show"/>
                <field name="x_factura_proveedor" placeholder="Factura Prov." optional="show"/>
                <field name="x_calibre" optional="show"/>
                <field name="x_ancho" optional="show"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_open_label_preview" string="Ver Etiqueta" type="object" icon="fa-search-plus" class="btn-sm btn-link text-info" title="Ver vista previa de la etiqueta Zebra"/>
            </xpath>
        </field>
    </record>

    <!-- Vista del formulario de operaciones de movimiento (stock.move) - Agregar botón de impresión masiva -->
    <record id="view_stock_move_operations_inherit" model="ir.ui.view">
        <field name="name">stock.move.operations.inherit.jkkpack</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('d-flex')]" position="after">
                <div class="d-flex mt-2">
                    <button name="action_print_all_labels_from_move" string="Imprimir Etiquetas Zebra" type="object" class="btn btn-primary btn-sm" icon="fa-print" title="Imprimir todas las etiquetas en un único ZPL para la impresora Zebra ZT411"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
