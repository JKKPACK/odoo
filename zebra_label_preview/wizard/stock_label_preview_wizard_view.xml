<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_label_preview_wizard_form" model="ir.ui.view">
        <field name="name">stock.label.preview.wizard.form</field>
        <field name="model">stock.label.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Vista Previa de Etiqueta">
                <sheet>
                    <div class="row">
                        <!-- Columna Izquierda: Renderizado exacto de la etiqueta -->
                        <div class="col-7 text-center" style="border-right: 1px solid #dee2e6; padding-right: 20px;">
                            <h4 class="mb-3" style="color: #4A5568; font-weight: bold;">Simulación de Impresión (ZT411)</h4>
                            <field name="preview_image" widget="image" options="{'size': [420, 630]}" class="img-fluid style-preview-border"/>
                        </div>
                        
                        <!-- Columna Derecha: Metadatos y debugging del código ZPL de control -->
                        <div class="col-5" style="padding-left: 20px;">
                            <h4 class="mb-3" style="color: #4A5568; font-weight: bold;">Información del Control</h4>
                            <group>
                                <field name="move_line_id" options="{'no_open': True}"/>
                            </group>
                            <notebook>
                                <page string="Código Fuente ZPL (Nativo)">
                                    <field name="zpl_code" widget="text" style="font-family: 'Courier New', monospace; font-size: 11px; background-color: #f8f9fa;" rows="15"/>
                                </page>
                            </notebook>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Imprimir en Zebra" name="action_print_physical_label" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
