<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="x_lote_proveedor" placeholder="Lote Prov." optional="show"/>
                <field name="x_rollo_proveedor" placeholder="Rollo Prov." optional="show"/>
                <field name="x_factura_proveedor" placeholder="Factura Prov." optional="show"/>
                <field name="x_calibre" optional="show"/>
                <field name="x_ancho" optional="show"/>
            </xpath>
            
            <xpath expr="//list" position="inside">
                <button name="action_open_label_preview" 
                        string="Ver Etiqueta" 
                        type="object" 
                        icon="fa-search-plus" 
                        class="btn-sm btn-link text-info"
                        title="Ver vista previa interactiva antes de mandar a imprimir a la Zebra"/>
            </xpath>
        </field>
    </record>
</odoo>
