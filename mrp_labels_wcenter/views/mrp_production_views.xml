<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_labels" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.labels</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_label_wizard" string="Imprimir Etiquetas de Rollos" type="object" class="btn-primary" invisible="state not in ['confirmed', 'progress']"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Etiquetas Emitidas" name="production_labels">
                    <field name="label_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="workcenter_id"/>
                            <field name="weight" sum="Total Peso"/>
                            <field name="date_produced"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
